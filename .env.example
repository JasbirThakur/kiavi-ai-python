# Database Connection (PostgreSQL 16 with native pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword2026@127.0.0.1:5433/kiavidb

# LLM Providers (NVIDIA NIM & Groq)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=meta/llama-3.2-11b-vision-instruct

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JWT Authentication
JWT_SECRET_KEY=kiavi-secret-production-key-2026

# Brandfetch API (Optional)
BRANDFETCH_API_KEY=your_brandfetch_api_key_here

# Environment & CORS
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
